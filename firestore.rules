rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Denegar todo por defecto)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Perfiles médicos privados de cada usuario
    match /users/{userId}/doctors/{doctorId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId)
                    && isValidId(doctorId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.nombreMedico is string
                    && request.resource.data.nombreMedico.size() > 0
                    && request.resource.data.nombreMedico.size() <= 200
                    && request.resource.data.especialidad is string
                    && request.resource.data.especialidad.size() <= 200
                    && request.resource.data.ciudad is string
                    && request.resource.data.ciudad.size() <= 100
                    && request.resource.data.configData is string;

      allow update: if isOwner(userId)
                    && isValidId(doctorId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.nombreMedico is string
                    && request.resource.data.nombreMedico.size() > 0
                    && request.resource.data.nombreMedico.size() <= 200
                    && request.resource.data.configData is string;

      allow delete: if isOwner(userId) && isValidId(doctorId);
    }
  }
}
